root = true

[*.cs]
# Dead code: unused usings, private members, assignments and parameters.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
# Public members can't drop parameters, and the Build-only factories such as H.Text(value) take theirs for Build.
dotnet_code_quality_unused_parameters = non_public

[src/**.cs]
# The template interfaces are markers that the generators and the render methods check for.
dotnet_diagnostic.CA1040.severity = none

[src/TemplateDsl.Generators/**.cs]
# Only Roslyn calls the generators and analyzers, and never with null.
dotnet_diagnostic.CA1062.severity = none

[{tests,samples}/**.cs]
# Test names and benchmark names are sentences and cases, with underscores.
dotnet_diagnostic.CA1707.severity = none
# Templates name the token of BuildAsync as they like, as the README does with ct, and Build is never called by name.
dotnet_diagnostic.CA1725.severity = none

[samples/TemplateDsl.Benchmarks/**.cs]
# BenchmarkDotNet runs instance methods.
dotnet_diagnostic.CA1822.severity = none
