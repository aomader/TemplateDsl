@inherits RazorSlice<SlicePageModel>
@* No whitespace between siblings: the output must match TemplateDsl's. *@
<html><body><div id="user-@Model.UserName" class="@(Model.IsAdmin ? "page admin" : "page")"><div class="header">Hello @Model.UserName@if (Model.Unread > 0) {<div class="unread">@Model.Unread unread</div>} else {@("No new messages")}</div><div class="nav"><div class="nav-item">Home</div><div class="nav-item">Projects</div><div class="nav-item">Settings</div>@if (Model.IsAdmin) {<div class="nav-item">Admin</div>}</div><div class="cards">@await RenderPartialAsync(SliceCard.Create(new("Inbox", $"Messages for {Model.UserName}", Model.Unread)))@await RenderPartialAsync(SliceCard.Create(new("Tasks", "Things to do", 3)))@await RenderPartialAsync(SliceCard.Create(new("Files", "Recent documents", 0)))@await RenderPartialAsync(SliceCard.Create(new("Teams", "People you work with", 7)))</div><div class="footer">Static footer text</div></div></body></html>