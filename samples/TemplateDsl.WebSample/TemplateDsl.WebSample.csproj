<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>WebSample</RootNamespace>
    
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Written by the compiler to look at, and part of the compilation already. -->
    <Compile Remove="Generated/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TemplateDsl.Html\TemplateDsl.Html.csproj" />
    <ProjectReference Include="..\..\src\TemplateDsl.AspNetCore\TemplateDsl.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\TemplateDsl.Generators\TemplateDsl.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
