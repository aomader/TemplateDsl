<Project Sdk="Microsoft.NET.Sdk">

  <!-- Published trimmed, and as native code where a C toolchain is installed, by run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Every trim and AOT warning on its own, instead of one per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The native compiler package can have advisories of its own, which this test doesn't need to fail on. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TemplateDsl.Html" Version="$(TemplateDslVersion)" />
    <PackageReference Include="TemplateDsl.AspNetCore" Version="$(TemplateDslVersion)" />
  </ItemGroup>

</Project>
