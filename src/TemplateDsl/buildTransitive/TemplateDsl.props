<Project>

  <!-- The render methods are extension methods, so calling them needs this namespace. -->
  <ItemGroup>
    <Using Include="TemplateDsl" />
  </ItemGroup>

  <!--
    What the generator reads: the namespace of the class with the template factories, Templates, and the name of that
    class, if the project sets another one with <TemplateDslTemplatesClass>App.Ui.Templates</TemplateDslTemplatesClass>.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="TemplateDslTemplatesClass" />
  </ItemGroup>

</Project>
