<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <!-- Checked by the trim and AOT analyzers, so that apps can trim it and compile it to native code. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Return TemplateDsl templates from ASP.NET Core minimal APIs and controllers, rendered as streaming UTF-8.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": the generator in that package must reach consumers of this one too. -->
    <ProjectReference Include="..\TemplateDsl\TemplateDsl.csproj" PrivateAssets="none" />

    <None Include="..\..\README.md" Pack="true" PackagePath="/" Visible="false" />

    <!-- Imports the namespace of ToResult and the results in projects using the package. -->
    <None Include="buildTransitive\TemplateDsl.AspNetCore.props" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
