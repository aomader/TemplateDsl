<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      The version of all packages, which are always released together. Merging a change of it to main publishes it,
      see .github/workflows/release.yml. 0.0.0 means that nothing is released yet: it is never published.
    -->
    <Version>0.1.0-preview.8</Version>
  </PropertyGroup>

  <!--
    Stricter checks in every project: the recommended .NET analyzers, and the code-style rules that .editorconfig
    raises, such as unused usings and parameters. The packages under src/ get all analyzers and must document their
    public API, see src/Directory.Build.props.
  -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Also what lets the build report unused usings (IDE0005). Only the packages have to document everything. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Package metadata, the same for all packages. Each project only adds its description. -->
  <PropertyGroup>
    <Authors>Alexander Oliver Mader</Authors>
    <Copyright>Copyright (c) 2026 Alexander Oliver Mader</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aomader/TemplateDsl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aomader/TemplateDsl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>html;templates;source-generator;dsl;domain-specific-language;streaming;htmx;aspnetcore</PackageTags>
    <PackageReleaseNotes>https://github.com/aomader/TemplateDsl/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- Debugging into the packages: Source Link (built into the SDK) points the symbols at the commit on GitHub. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
